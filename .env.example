# Server-only — never use VITE_ for secrets
XAI_API_KEY=

# Your Voice Agent (preferred for “the agent I created”)
# Example: agent_K9qbsc619Vbg0nvm
XAI_VOICE_AGENT_ID=

# Optional REST TTS fallback voice (ara | eve | leo | sal | rex | custom TTS id)
# If you put agent_… here it also works (we detect it), but prefer XAI_VOICE_AGENT_ID.
XAI_TTS_VOICE=ara

# Client-visible
VITE_CONTENT_CORPUS=demo_historical
VITE_KEEPER_PORTAL_URL=
