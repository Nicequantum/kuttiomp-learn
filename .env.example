# Server-only secrets (never VITE_)
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_TTS_VOICE=ara

# demo_historical | keeper_only
VITE_CONTENT_CORPUS=demo_historical

# The one env that connects Learn to Kuttiomp.
# Leave empty until GET /api/v1/public/lexicon is deployed.
# When set (no trailing slash), Learn paginates that public lexicon.
# Example: https://your-kuttiomp-api.example.com
VITE_API_BASE_URL=

# DANGER — engineering only. Ships fake “living” rows if true.
# Never enable on Vercel production. Leave false/unset so Williams
# demo seed is the only offline corpus. Live API ignores this flag.
VITE_USE_MOCK_PUBLIC_API=false

VITE_KEEPER_PORTAL_URL=https://kuttiomp-admin-viti.vercel.app
