# Server-only — Grok Text-to-Speech (never use VITE_ prefix for this)
XAI_API_KEY=
# Optional voice id: ara | eve | leo | sal | rex | …
XAI_TTS_VOICE=ara

# Client-visible (VITE_*)
# demo_historical | keeper_only
VITE_CONTENT_CORPUS=demo_historical
# Full URL to Knowledge Keeper / admin portal
VITE_KEEPER_PORTAL_URL=
