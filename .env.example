# Server-only secrets (never VITE_)
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_TTS_VOICE=ara

# Client-visible corpus control
# demo_historical = Williams seed (default)
# keeper_only = public API only (no Williams)
VITE_CONTENT_CORPUS=demo_historical

# Kuttiomp monorepo public API origin (no trailing slash)
# Example: https://your-api.vercel.app
# Leave empty until GET /api/v1/public/lexicon exists
VITE_API_BASE_URL=

# Admin / Keeper portal
VITE_KEEPER_PORTAL_URL=https://kuttiomp-admin-viti.vercel.app
