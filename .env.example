# Server-only secrets (never VITE_)
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_TTS_VOICE=ara

# demo_historical | keeper_only
# Keep demo_historical until Keepers cut over (Learn merges live words over Williams).
VITE_CONTENT_CORPUS=demo_historical

# Kuttiomp FastAPI origin (no trailing slash).
# Local pairing: Kuttiomp apps/api on port 8000.
# Production: do not invent a host. After you deploy FastAPI (Railway / Fly / Render),
# set the same origin on Vercel as VITE_API_BASE_URL. Vite bakes this in at build time.
VITE_API_BASE_URL=http://localhost:8000

# Engineering: test living-forms pipeline without backend (filters sacred mocks).
# Ignored when VITE_API_BASE_URL is set — live API always wins.
VITE_USE_MOCK_PUBLIC_API=true

# Knowledge Keeper portal (admin). Local Next.js is :3000.
# Production: https://kuttiomp-admin.vercel.app
VITE_KEEPER_PORTAL_URL=https://kuttiomp-admin.vercel.app
